{
  "name": "riftwarden-echo-siege",
  "version": "4.1.0",
  "private": true,
  "type": "module",
  "description": "Trò chơi sinh tồn hành động TypeScript/Canvas vận hành bằng dữ liệu.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && node scripts/dev-server.mjs",
    "start": "node scripts/dev-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run test",
    "build:release": "node scripts/build.mjs --release",
    "balance:audit": "node scripts/balance-audit.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "sharp": "^0.35.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
